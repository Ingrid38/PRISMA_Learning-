# Configuración de Supabase
# Obtén estos valores en: Project Settings -> Data API (o API)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_KEY=TU_SUPABASE_ANON_O_SERVICE_KEY

# Contraseña de la base de datos (PostgreSQL directo si se requiere):
# Password configurada: ystemedu_123

# Clave gratuita de Google AI Studio (Gemini Flash)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Ilustración referencial (Cloudflare Workers AI, plan gratuito)
CLOUDFLARE_ACCOUNT_ID=tu_account_id
